{
  "buildCommand": "npm install && npm run build:css",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/brochure",
      "destination": "/brochure.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/brochure.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
